{
  "version": 1,
  "bridge": "local_miio",
  "source": "vevs_logs",
  "notes": [
    "Local LAN control only; no Mi Home cloud and no stock Mi Home app.",
    "Vevs is used to provision devices and expose token/IP/model logs.",
    "Never commit real tokens; keep this file in local app storage.",
    "Slots 1-5 are active; slot 6 is an inactive placeholder.",
    "Kettle command is model-specific: confirm set_temperature vs MIoT set_properties before enabling.",
    "timeout_ms is per device; the slow Rockrobo vacuum uses 20000 ms.",
    "no_ack marks commands that may execute without a response."
  ],
  "devices": {
    "vacuum_1": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Пылесос 1"
    },
    "vacuum_2": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Пылесос 2",
      "timeout_ms": 20000,
      "no_ack": true
    },
    "socket": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Розетка"
    },
    "kettle": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Чайник"
    }
  },
  "slots": [
    {
      "slot": 1,
      "label": "Пылесос 1",
      "icon": "vacuum",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "vacuum_1",
        "method": "app_start",
        "params": []
      }
    },
    {
      "slot": 2,
      "label": "Пылесос 2",
      "icon": "vacuum",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "vacuum_2",
        "method": "app_start",
        "params": []
      }
    },
    {
      "slot": 3,
      "label": "Розетка вкл",
      "icon": "plug",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "socket",
        "method": "set_power",
        "params": [
          "on"
        ]
      }
    },
    {
      "slot": 4,
      "label": "Розетка выкл",
      "icon": "plug",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "socket",
        "method": "set_power",
        "params": [
          "off"
        ]
      }
    },
    {
      "slot": 5,
      "label": "Чайник 45°C",
      "icon": "kettle",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "kettle",
        "method": "set_temperature",
        "params": [
          45
        ]
      }
    },
    {
      "slot": 6,
      "label": "—",
      "icon": "empty",
      "enabled": false,
      "action": null
    }
  ]
}
