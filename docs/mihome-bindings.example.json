{
  "version": 1,
  "bridge": "local_miio",
  "source": "vevs_logs",
  "notes": [
    "Local LAN control only; no Mi Home cloud and no stock Mi Home app.",
    "Vevs is used to provision devices and expose token/IP/model logs.",
    "Never commit real tokens; keep this file in local app storage.",
    "Slots 5 and 6 are inactive placeholders."
  ],
  "devices": {
    "vacuum_1": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Пылесос 1"
    },
    "vacuum_2": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Пылесос 2"
    },
    "socket": {
      "model": "<model from Vevs logs>",
      "host": "<lan ip>",
      "token": "<local only>",
      "name": "Розетка"
    }
  },
  "slots": [
    {
      "slot": 1,
      "label": "Пылесос 1",
      "icon": "vacuum",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "vacuum_1",
        "method": "app_start",
        "params": []
      }
    },
    {
      "slot": 2,
      "label": "Пылесос 2",
      "icon": "vacuum",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "vacuum_2",
        "method": "app_start",
        "params": []
      }
    },
    {
      "slot": 3,
      "label": "Розетка вкл",
      "icon": "plug",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "socket",
        "method": "set_power",
        "params": ["on"]
      }
    },
    {
      "slot": 4,
      "label": "Розетка выкл",
      "icon": "plug",
      "enabled": true,
      "action": {
        "type": "miio",
        "device": "socket",
        "method": "set_power",
        "params": ["off"]
      }
    },
    {
      "slot": 5,
      "label": "—",
      "icon": "empty",
      "enabled": false,
      "action": null
    },
    {
      "slot": 6,
      "label": "—",
      "icon": "empty",
      "enabled": false,
      "action": null
    }
  ]
}
